generator client {
  provider      = "prisma-client-js"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model User {
  id          String            @id @default(uuid())
  email       String            @unique
  name        String?
  createdAt   DateTime          @default(now())
  workspaces  WorkspaceMember[]
}

model Workspace {
  id            String            @id @default(uuid())
  name          String
  companyName   String?
  address       String?
  phone         String?
  brandingLogo  String?
  brandingColor String?
  
  // 🚀 GST Compliance Fields
  gstin         String?
  state         String?
  
  createdAt     DateTime          @default(now())
  
  members       WorkspaceMember[]
  customers     Customer[]
  products      Product[]
  invoices      Invoice[]
  lineItems     InvoiceLineItem[]
  
  // 🚀 NEW: Link to Expenses for the Balance Sheet
  expenses      Expense[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can only have one role per workspace
  @@unique([workspaceId, userId]) 
}

model Customer {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  email       String?
  taxId       String?
  address     String?
  
  // 🚀 GST Compliance Fields
  gstin       String?
  state       String?
  
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
}

// 🚀 Supports full inventory tracking and future GST compliance
model Product {
  id            String   @id @default(uuid())
  workspaceId   String
  name          String
  description   String?
  sku           String?           // Stock Keeping Unit / Barcode
  price         Float
  taxRate       Float    @default(0)
  stockQuantity Int      @default(0) // Tracks current inventory level
  hsnCode       String?           // Saved for Phase 2: Indian GST Compliance
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lineItems     InvoiceLineItem[]
  
  // Connects to your active dynamic form items!
  invoiceItems  InvoiceItem[]     
}

model Invoice {
  id            String          @id @default(uuid())
  workspaceId   String
  customerId    String
  invoiceNumber String
  status        InvoiceStatus   @default(DRAFT)
  issueDate     DateTime        @default(now())
  dueDate       DateTime

  currency      String   @default("INR")

  subTotal      Float
  taxTotal      Float
  grandTotal    Float
  
  // 🚀 GST Breakdown Fields
  taxType       String   @default("NONE") // e.g., "CGST_SGST", "IGST", "NONE"
  cgstTotal     Float    @default(0)
  sgstTotal     Float    @default(0)
  igstTotal     Float    @default(0)
  
  createdAt     DateTime        @default(now())

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  // This is what our current dynamic form uses
  items         InvoiceItem[]
  
  // This is what you saved for the future Product integrations
  lineItems     InvoiceLineItem[] 
}

model InvoiceLineItem {
  id          String @id @default(uuid())
  workspaceId String 
  invoiceId   String
  productId   String
  quantity    Int
  unitPrice   Float
  taxAmount   Float
  totalAmount Float

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])
}

// 🚀 The missing piece now supports linking to Products for stock deduction
model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  
  // Optional link to Product. If filled, we deduct stock when invoice is created!
  productId   String?  
  product     Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Int      @default(1)
  price       Float
  total       Float
  
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

// 🚀 NEW: Expense tracking model for True Balance Sheet Generation
model Expense {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  amount      Float
  category    String    // e.g., "SOFTWARE", "RENT", "MARKETING", "HARDWARE"
  description String?
  date        DateTime  @default(now())
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}